# ------------------------------------------------------------------
# Salkara x CISO Marine World - Coupon Management
# Copy this file to .env.local for local development, and set the same
# variables in Vercel -> Project -> Settings -> Environment Variables.
# ------------------------------------------------------------------

# --- Session / security ---
# A long random string used to sign login sessions AND to derive the
# encryption key for the coupon data at rest. Use at least 32 characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# (Optional) Use a dedicated key to encrypt the coupon data blob.
# If not set, it is derived from SESSION_SECRET.
# DATA_ENCRYPTION_KEY=another-long-random-string

# --- Staff logins ---
# Login used by Salkara restaurant staff (issue coupons, apply food discount)
SALKARA_USERNAME=salkara
SALKARA_PASSWORD=change-me-salkara

# Login used by CISO Marine World staff (redeem tickets discount)
MARINE_USERNAME=marine
MARINE_PASSWORD=change-me-marine

# --- Vercel Blob storage (the "database") ---
# Created automatically when you add a Blob store to the Vercel project.
# Vercel -> Storage -> Create -> Blob -> Connect to project.
# Leave EMPTY for local development to fall back to a local .data file.
BLOB_READ_WRITE_TOKEN=

# --- WhatsApp contact numbers (shown as buttons, in international format) ---
# Digits only, including country code, no "+" and no spaces.
# Example for Saudi Arabia: 9665XXXXXXXX
NEXT_PUBLIC_SALKARA_WHATSAPP=9665XXXXXXXX
NEXT_PUBLIC_MARINE_WHATSAPP=9665XXXXXXXX

# --- Public base URL of the deployed app (used inside WhatsApp messages) ---
# On Vercel this is your production domain, e.g. https://your-app.vercel.app
# Leave empty locally; the browser origin is used as a fallback.
NEXT_PUBLIC_BASE_URL=
